# Public website origin for canonical links, sitemap and metadata.
# Locally use http://localhost:3000; on Vercel use your real HTTPS domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only HTTPS endpoint that accepts and saves enquiry JSON.
# Required for successful form submissions; not needed to browse the site.
INQUIRY_WEBHOOK_URL=

# Optional server-only bearer secret; must match your receiver's configuration.
INQUIRY_WEBHOOK_TOKEN=
